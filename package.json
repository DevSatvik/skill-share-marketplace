{
  "name": "skill-share-marketplace",
  "scripts": {
    "predev": "npm install --prefix backend && npm install --prefix frontend",

    "dev-backend": "npm --prefix backend run server",
    "dev-frontend": "npm --prefix frontend run dev",

    "test-backend": "npm --prefix backend run test",

    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
